{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "productTryOnDefault": { "type": "boolean", "default": false },
    "addresses": {
      "type": "object",
      "required": [
        "internationalEnabled",
        "allowedCountryCodes",
        "defaultCountryCode"
      ],
      "properties": {
        "internationalEnabled": {
          "type": "boolean"
        },
        "allowedCountryCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": "Empty allows all ISO countries when international addresses are enabled."
        },
        "defaultCountryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "productImport": {
      "type": "object",
      "required": [
        "sellerImageMode",
        "sellerGeneratedImageRoles"
      ],
      "properties": {
        "modelReferenceBucket": {
          "type": "string",
          "description": "Optional separate private S3 bucket for identity references; uses existing storage endpoint and credentials. Never the public media bucket."
        },
        "modelReferenceKey": {
          "type": "string",
          "description": "Optional private storage object key for a consented model face reference. Omit to preserve envFrom Secret control; empty disables the reference. Never a URL or asset bytes."
        },
        "sellerImageMode": {
          "type": "string",
          "enum": [
            "generate",
            "provided"
          ]
        },
        "sellerGeneratedImageRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "product_only",
              "mannequin",
              "model"
            ]
          }
        },
        "sellerTryOnEnabled": { "type": "boolean", "default": false },
        "sellerTypedColorsEnabled": {
          "type": "boolean",
          "default": false
        }
      },
      "if": {
        "properties": {
          "sellerImageMode": {
            "const": "generate"
          }
        }
      },
      "then": {
        "properties": {
          "sellerGeneratedImageRoles": {
            "minItems": 1
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "emuEnabled": {
          "type": "boolean",
          "description": "Optional API/worker EMU switch; omit to preserve envFrom Secret control (backend default false)."
        }
      }
    }
  }
}
